<?xml version="1.0" encoding="UTF-8"?>
<!-- A track with timestamps but no <name> — US-12's other prefill case: the
     import screen has a date to suggest but no track name to go with it, so
     the name field is prefilled with the bare "YYYY-MM-DD " prefix and the
     owner completes it. Same shape and date as sample.gpx, so the two
     fixtures differ in exactly the one thing under test. -->
<gpx version="1.1" creator="trip-archive-test"
     xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <trkseg>
      <trkpt lat="59.9139" lon="10.7522">
        <ele>10.0</ele>
        <time>2024-06-01T08:00:00Z</time>
      </trkpt>
      <trkpt lat="59.9200" lon="10.7600">
        <ele>50.0</ele>
        <time>2024-06-01T08:30:00Z</time>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
